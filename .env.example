# Gercek degerler .env dosyasina yazilir; .env commit edilmez.

# Uygulama baglantisi (bist_app rolu; yalnizca INSERT/SELECT + cozum sutunlarinda UPDATE)
DATABASE_URL=postgresql://bist_app:CHANGE_ME@postgres-ortak:5432/bist_tahmin

# Yalnizca `bist init` icin: veritabani ve rolleri olusturabilen yonetici baglantisi.
# Uretimde sadece elle, init sirasinda kullanilir; konteynerin .env'ine KONMAZ.
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5434/postgres

# `bist init` bist_app rolunu ilk kez olusturuyorsa kullanilacak parola
BIST_APP_PASSWORD=CHANGE_ME

# TCMB EVDS anahtari (ucretsiz). Koda gomulmez.
EVDS_KEY=

# Opsiyonel: yapilandirma dosyasi yolu (varsayilan config/default.yaml)
# BIST_CONFIG=config/default.yaml
