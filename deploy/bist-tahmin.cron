# /etc/cron.d/bist-tahmin  (PROJE.md Bolum 12, 19)
# Sunucu Europe/Berlin'de ve cron (Debian 3.0pl1) CRON_TZ desteklemez (2026-11-08'de denendi: tetiklenmedi).
# Istanbul (UTC+3, sabit) ile Berlin arasi fark yaz/kis 1 ya da 2 saattir. Bu yuzden her is Berlin saatiyle IKI
# olasi saatte planlanir ve sarmalayici ONLY_IST_HOUR ile gercek Istanbul saatini kontrol edip yalniz birinde calisir:
#   19:00 Istanbul = 17:00 Berlin (kis, CET)  ya da 18:00 Berlin (yaz, CEST)
# Kurulum: sudo cp deploy/bist-tahmin.cron /etc/cron.d/bist-tahmin && sudo chmod 644 /etc/cron.d/bist-tahmin
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Hafta ici 19:00 Istanbul: evren -> indir+kalite -> coz -> tahmin.
0 17,18 * * 1-5 root ONLY_IST_HOUR=19 /opt/bist-tahmin/deploy/cron_run.sh run-daily run-daily
# 19:45 Istanbul: yalnizca bugun basarisiz/eksikse yeniden dene (RETRY=1; gec gelen veri icin). Resmi tatilde bar yok:
# akis bayat saymaz, idempotenttir.
45 17,18 * * 1-5 root ONLY_IST_HOUR=19 RETRY=1 /opt/bist-tahmin/deploy/cron_run.sh run-daily run-daily

# Cumartesi 10:00 Istanbul haftalik rapor (salt okunur) -> /opt/bist-tahmin/reports/rapor-YYYY-AA-GG.md
0 8,9 * * 6 root ONLY_IST_HOUR=10 /opt/bist-tahmin/deploy/cron_weekly.sh

# Hafta ici 20:30 Istanbul saglik kontrolu (`bist health`): akis calisti mi, veri guncel mi, devre kesici acik mi?
# 20:30 Istanbul = 18:30 Berlin (kis) ya da 19:30 Berlin (yaz). Cikis != 0 ise /opt/bist-tahmin/logs/ALERT.txt + syslog.
30 18,19 * * 1-5 root ONLY_IST_HOUR=20 /opt/bist-tahmin/deploy/cron_health.sh
